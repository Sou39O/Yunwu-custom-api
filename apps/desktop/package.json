{
  "name": "@yunwu/desktop",
  "version": "0.7.3",
  "private": true,
  "description": "Yunwu desktop shell",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare-server": "node scripts/prepare-server.mjs",
    "package": "pnpm build && pnpm prepare-server && electron-builder --win zip",
    "package:dir": "pnpm build && pnpm prepare-server && electron-builder --win dir",
    "test": "pnpm build && node --test test/release-updates.test.cjs"
  },
  "dependencies": {
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^37.6.0",
    "electron-builder": "^26.0.12",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "ai.yunwu.desktop",
    "productName": "Yunwu Desktop",
    "electronDist": "./node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
